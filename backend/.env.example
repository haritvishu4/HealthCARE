# Run python scripts/setup.py to generate backend/.env with random local secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://care:change-me@localhost:5432/care
FIELD_ENCRYPTION_KEY=
DEV_AUTH_TOKEN=

# Keep all provider keys on the backend. Never add keys to frontend JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
OCR_API_KEY=
OCR_LANGUAGE=eng

# Required for production Supabase JWT verification (asymmetric signing keys).
SUPABASE_URL=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","api"]
MAX_UPLOAD_BYTES=10485760
PROVIDER_TIMEOUT=45
DOCS_ENABLED=true
